{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portfolio Manager",
  "version": "0.18.0",
  "identifier": "com.pmapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Portfolio Manager",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxMUIxQjkyMDMxOTExM0YKUldRL0VSa0RraHNiVVlGMXZSbExXZmNKcnZJaTF6NnZQM1ZTYzNIdG5CcFc5VG9xMnI1Rm9NWW4K",
      "endpoints": [
        "https://github.com/saiindudrugs-stack/StockTracker/releases/latest/download/latest.json"
      ]
    }
  }
}
